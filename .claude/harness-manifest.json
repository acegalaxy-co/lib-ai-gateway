      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf .git:*)",
      "Edit(./**/*.pem)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Write(./**/*.pem)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./secrets/**)"
    ],
    "env": {
